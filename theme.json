{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "color": {
            "custom": false,
            "customGradient": false,
            "defaultPalette": false,
            "defaultGradients": false,
            "palette": [
                { "slug": "red", "name": "Red", "color": "#D22630" },
                { "slug": "dark-red", "name": "Dark Red (feature)", "color": "#931920" },
                { "slug": "blue", "name": "Blue", "color": "#005A91" },
                { "slug": "blue-hover", "name": "Blue Hover", "color": "#033B5E" },
                { "slug": "bright-blue", "name": "Bright Blue", "color": "#009EFF" },
                { "slug": "yellow", "name": "Yellow (banner only)", "color": "#FFD600" },
                { "slug": "charcoal", "name": "Charcoal", "color": "#2C2C2C" },
                { "slug": "dark", "name": "Dark (background)", "color": "#1C1B1A" },
                { "slug": "off-white", "name": "Off-White", "color": "#FCFAF2" },
                { "slug": "white", "name": "White", "color": "#FFFFFF" },
                { "slug": "neutral-lightest", "name": "Neutral Lightest", "color": "#EEEEEE" },
                { "slug": "neutral-lighter", "name": "Neutral Lighter", "color": "#CCCCCC" },
                { "slug": "neutral-light", "name": "Neutral Light", "color": "#AAAAAA" },
                { "slug": "neutral", "name": "Neutral", "color": "#666666" },
                { "slug": "neutral-dark", "name": "Neutral Dark", "color": "#444444" },
                { "slug": "neutral-darker", "name": "Neutral Darker", "color": "#222222" },
                { "slug": "black", "name": "Black", "color": "#000000" }
            ],
            "gradients": [
                {
                    "slug": "background",
                    "name": "Background (dark to red)",
                    "gradient": "linear-gradient(rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.2)), linear-gradient(180deg, #1C1B1A 0%, #2C0D13 55%, #6A111B 100%)"
                },
                {
                    "slug": "header",
                    "name": "Header tint (red)",
                    "gradient": "linear-gradient(90deg, rgba(2, 1, 2, 0.2) 0%, rgba(210, 38, 48, 0.2) 19%)"
                },
                {
                    "slug": "section-red",
                    "name": "Section tint (red, bottom to top)",
                    "gradient": "linear-gradient(0deg, rgba(106, 20, 25, 0.2) 0%, rgba(210, 38, 48, 0.2) 79%, rgba(2, 1, 2, 0.2) 100%)"
                }
            ]
        },
        "typography": {
            "fluid": true,
            "customFontSize": false,
            "defaultFontSizes": false,
            "fontFamilies": [
                {
                    "slug": "heading",
                    "name": "Cormorant Garamond",
                    "fontFamily": "\"Cormorant Garamond\", Georgia, serif"
                },
                {
                    "slug": "body",
                    "name": "Inter",
                    "fontFamily": "Inter, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"
                }
            ],
            "fontSizes": [
                { "slug": "tiny", "name": "Tiny", "size": "0.75rem", "fluid": false },
                { "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
                { "slug": "regular", "name": "Regular", "size": "1rem", "fluid": false },
                { "slug": "medium", "name": "Medium", "size": "1.125rem", "fluid": { "min": "1rem", "max": "1.125rem" } },
                { "slug": "large", "name": "Large", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.25rem" } },
                { "slug": "h6", "name": "Heading 6", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.25rem" } },
                { "slug": "h5", "name": "Heading 5", "size": "1.5rem", "fluid": { "min": "1.25rem", "max": "1.5rem" } },
                { "slug": "h4", "name": "Heading 4", "size": "2rem", "fluid": { "min": "1.5rem", "max": "2rem" } },
                { "slug": "h3", "name": "Heading 3", "size": "2.5rem", "fluid": { "min": "2rem", "max": "2.5rem" } },
                { "slug": "h2", "name": "Heading 2", "size": "3rem", "fluid": { "min": "2.25rem", "max": "3rem" } },
                { "slug": "h1", "name": "Heading 1", "size": "3.5rem", "fluid": { "min": "2.5rem", "max": "3.5rem" } }
            ]
        },
        "spacing": {
            "units": [ "px", "rem", "%", "vw" ],
            "spacingSizes": [
                { "slug": "10", "name": "XS", "size": "0.5rem" },
                { "slug": "20", "name": "S", "size": "1rem" },
                { "slug": "30", "name": "M", "size": "1.5rem" },
                { "slug": "40", "name": "L", "size": "2rem" },
                { "slug": "50", "name": "Section Small", "size": "clamp(1.5rem, 1rem + 2.5vw, 3rem)" },
                { "slug": "60", "name": "Section Medium", "size": "clamp(2rem, 1rem + 5vw, 5rem)" },
                { "slug": "70", "name": "Section Large", "size": "clamp(3rem, 1.667rem + 6.667vw, 7rem)" }
            ]
        },
        "layout": {
            "contentSize": "768px",
            "wideSize": "1280px"
        },
        "custom": {
            "padding-global": "clamp(1rem, 5vw, 4rem)",
            "container-medium": "1024px"
        }
    }
}