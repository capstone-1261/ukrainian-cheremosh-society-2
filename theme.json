{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "useRootPaddingAwareAlignments": true,
        "color": {
            "custom": false,
            "customGradient": false,
            "defaultPalette": false,
            "defaultGradients": false,
            "palette": [
                { "slug": "red", "name": "Red", "color": "#D22630" },
                { "slug": "dark-red", "name": "Dark Red (feature)", "color": "#931920" },
                { "slug": "blue", "name": "Blue", "color": "#005A91" },
                { "slug": "blue-hover", "name": "Blue Hover", "color": "#033B5E" },
                { "slug": "bright-blue", "name": "Bright Blue", "color": "#009EFF" },
                { "slug": "yellow", "name": "Yellow (banner only)", "color": "#FFD600" },
                { "slug": "charcoal", "name": "Charcoal", "color": "#2C2C2C" },
                { "slug": "off-white", "name": "Off-White", "color": "#FCFAF2" },
                { "slug": "white", "name": "White", "color": "#FFFFFF" },
                { "slug": "neutral-lightest", "name": "Neutral Lightest", "color": "#EEEEEE" },
                { "slug": "neutral-lighter", "name": "Neutral Lighter", "color": "#CCCCCC" },
                { "slug": "neutral-light", "name": "Neutral Light", "color": "#AAAAAA" },
                { "slug": "neutral", "name": "Neutral", "color": "#666666" },
                { "slug": "neutral-dark", "name": "Neutral Dark", "color": "#444444" },
                { "slug": "neutral-darker", "name": "Neutral Darker", "color": "#222222" },
                { "slug": "black", "name": "Black", "color": "#000000" }
            ],
            "gradients": [
                {
                    "slug": "section-red",
                    "name": "Section (dark to red)",
                    "gradient": "linear-gradient(180deg, #2C0D12 13.85%, #6A111B 41.36%, #D22630 68.88%)"
                },
                {
                    "slug": "section-fade",
                    "name": "Section (dark red to charcoal)",
                    "gradient": "linear-gradient(180deg, #2C0D13 0%, #2C2C2C 100%)"
                },
                {
                    "slug": "header",
                    "name": "Header tint (red)",
                    "gradient": "linear-gradient(90deg, rgba(2, 1, 2, 0.2) 0%, rgba(210, 38, 48, 0.2) 19%)"
                }
            ]
        },
        "shadow": {
            "defaultPresets": false,
            "presets": [
                { "slug": "large", "name": "Large", "shadow": "0 8px 8px -4px rgba(0, 0, 0, 0.03), 0 20px 24px -4px rgba(0, 0, 0, 0.08)" }
            ]
        },
        "typography": {
            "fluid": true,
            "customFontSize": false,
            "defaultFontSizes": false,
            "fontFamilies": [
                {
                    "slug": "heading",
                    "name": "Cormorant Garamond",
                    "fontFamily": "\"Cormorant Garamond\", Georgia, serif",
                    "fontFace": [
                        {
                            "fontFamily": "Cormorant Garamond",
                            "fontStyle": "normal",
                            "fontWeight": "300 700",
                            "fontDisplay": "swap",
                            "src": [ "file:./assets/fonts/cormorant-garamond.woff2" ]
                        }
                    ]
                },
                {
                    "slug": "body",
                    "name": "Inter",
                    "fontFamily": "Inter, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif",
                    "fontFace": [
                        {
                            "fontFamily": "Inter",
                            "fontStyle": "normal",
                            "fontWeight": "100 900",
                            "fontDisplay": "swap",
                            "src": [ "file:./assets/fonts/inter.woff2" ]
                        }
                    ]
                }
            ],
            "fontSizes": [
                { "slug": "tiny", "name": "Tiny", "size": "0.75rem", "fluid": false },
                { "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
                { "slug": "regular", "name": "Regular", "size": "1rem", "fluid": false },
                { "slug": "medium", "name": "Medium", "size": "1.125rem", "fluid": { "min": "1rem", "max": "1.125rem" } },
                { "slug": "large", "name": "Large", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.25rem" } },
                { "slug": "h6", "name": "Heading 6", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.25rem" } },
                { "slug": "h5", "name": "Heading 5", "size": "1.5rem", "fluid": { "min": "1.25rem", "max": "1.5rem" } },
                { "slug": "h4", "name": "Heading 4", "size": "2rem", "fluid": { "min": "1.5rem", "max": "2rem" } },
                { "slug": "h3", "name": "Heading 3", "size": "2.5rem", "fluid": { "min": "2rem", "max": "2.5rem" } },
                { "slug": "h2", "name": "Heading 2", "size": "3rem", "fluid": { "min": "2.25rem", "max": "3rem" } },
                { "slug": "h1", "name": "Heading 1", "size": "3.5rem", "fluid": { "min": "2.5rem", "max": "3.5rem" } }
            ]
        },
        "spacing": {
            "units": [ "px", "rem", "%", "vw" ],
            "spacingSizes": [
                { "slug": "10", "name": "XS", "size": "0.5rem" },
                { "slug": "20", "name": "S", "size": "1rem" },
                { "slug": "30", "name": "M", "size": "1.5rem" },
                { "slug": "40", "name": "L", "size": "2rem" },
                { "slug": "50", "name": "Section Small", "size": "clamp(1.5rem, 1rem + 2.5vw, 3rem)" },
                { "slug": "60", "name": "Section Medium", "size": "clamp(2rem, 1rem + 5vw, 5rem)" },
                { "slug": "70", "name": "Section Large", "size": "clamp(3rem, 1.667rem + 6.667vw, 7rem)" }
            ]
        },
        "layout": {
            "contentSize": "768px",
            "wideSize": "1280px"
        },
        "custom": {
            "padding-global": "clamp(1rem, 5vw, 4rem)",
            "container-medium": "1024px",
            "container-small": "480px"
        }
    },
    "styles": {
        "color": {
            "background": "var(--wp--preset--color--charcoal)",
            "text": "var(--wp--preset--color--off-white)"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--body)",
            "fontSize": "var(--wp--preset--font-size--regular)",
            "lineHeight": "1.5"
        },
        "spacing": {
            "padding": {
                "left": "var(--wp--custom--padding-global)",
                "right": "var(--wp--custom--padding-global)"
            },
            "blockGap": "var(--wp--preset--spacing--30)"
        },
        "css": ".has-large-font-size { line-height: 1.4; } .has-medium-font-size { line-height: 1.556; } .has-small-font-size { line-height: 1.429; } .has-tiny-font-size { line-height: 1.333; } .wp-block-button.is-style-outline > .wp-block-button__link:hover { background: var(--wp--preset--color--off-white); color: var(--wp--preset--color--charcoal); } .is-style-card-red .wp-block-button.is-style-outline > .wp-block-button__link:hover { color: var(--wp--preset--color--red); }",
        "elements": {
            "heading": {
                "color": { "text": "var(--wp--preset--color--off-white)" },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--heading)",
                    "fontWeight": "700",
                    "lineHeight": "1.2",
                    "textTransform": "uppercase"
                }
            },
            "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--h-1)", "lineHeight": "1.143" } },
            "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--h-2)", "lineHeight": "1.167" } },
            "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--h-3)", "lineHeight": "1.2" } },
            "h4": { "typography": { "fontSize": "var(--wp--preset--font-size--h-4)", "lineHeight": "1.25" } },
            "h5": { "typography": { "fontSize": "var(--wp--preset--font-size--h-5)", "lineHeight": "1.333" } },
            "h6": { "typography": { "fontSize": "var(--wp--preset--font-size--h-6)", "lineHeight": "1.4" } },
            "link": {
                "color": { "text": "var(--wp--preset--color--off-white)" },
                "typography": { "textDecoration": "underline" },
                ":hover": {
                    "typography": { "textDecoration": "none" }
                },
                ":focus-visible": {
                    "outline": {
                        "color": "var(--wp--preset--color--off-white)",
                        "style": "solid",
                        "width": "2px",
                        "offset": "2px"
                    }
                }
            },
            "button": {
                "color": {
                    "background": "var(--wp--preset--color--off-white)",
                    "text": "var(--wp--preset--color--charcoal)"
                },
                "border": {
                    "width": "2px",
                    "style": "solid",
                    "color": "var(--wp--preset--color--off-white)",
                    "radius": "0"
                },
                "typography": {
                    "fontFamily": "var(--wp--preset--font-family--heading)",
                    "fontSize": "var(--wp--preset--font-size--large)",
                    "fontWeight": "600",
                    "textTransform": "uppercase"
                },
                "spacing": {
                    "padding": {
                        "top": "0.625rem",
                        "bottom": "0.625rem",
                        "left": "1.375rem",
                        "right": "1.375rem"
                    }
                },
                ":hover": {
                    "color": {
                        "background": "var(--wp--preset--color--charcoal)",
                        "text": "var(--wp--preset--color--off-white)"
                    }
                },
                ":focus-visible": {
                    "outline": {
                        "color": "var(--wp--preset--color--off-white)",
                        "style": "solid",
                        "width": "2px",
                        "offset": "3px"
                    }
                }
            }
        },
        "blocks": {
            "core/button": {
                "variations": {
                    "outline": {
                        "color": {
                            "background": "transparent",
                            "text": "var(--wp--preset--color--off-white)"
                        },
                        "border": {
                            "width": "2px",
                            "style": "solid",
                            "color": "var(--wp--preset--color--off-white)"
                        }
                    }
                }
            }
        }
    }
}