{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "title": "Card: Charcoal",
    "slug": "card-charcoal",
    "blockTypes": [ "core/group", "core/column" ],
    "styles": {
        "color": {
            "background": "var(--wp--preset--color--charcoal)",
            "text": "var(--wp--preset--color--off-white)"
        },
        "border": {
            "top": {
                "color": "var(--wp--preset--color--bright-blue)",
                "width": "4px",
                "style": "solid"
            }
        },
        "spacing": {
            "padding": { "top": "1rem", "right": "1rem", "bottom": "1rem", "left": "1rem" }
        },
        "shadow": "var(--wp--preset--shadow--large)"
    }
}